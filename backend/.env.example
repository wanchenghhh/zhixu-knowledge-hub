# 本机可直接使用默认 SQLite + 本地持久化任务。
HUB_ENVIRONMENT=development
HUB_DATABASE_URL=sqlite:///./runtime/knowledge.db
HUB_DATA_DIR=./runtime
HUB_QUEUE_MODE=local
# 生产环境必须设定 Fernet 主密钥，并使用 PostgreSQL。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# HUB_ENCRYPTION_KEY=
HUB_REDIS_URL=redis://localhost:6379/0
HUB_LOG_RETENTION_DAYS=90
